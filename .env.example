# GULLYGANG — Production Environment Configuration Template
# Duplicate this file to .env.local for local development / server config

# InsForge BaaS Backend URL, Anon Key & Server Privileged API Key
INSFORGE_URL="https://your-project.ap-southeast.insforge.app"
INSFORGE_ANON_KEY="your_insforge_anon_key"
INSFORGE_API_KEY="your_server_only_project_api_key"

# PostHog Product Analytics
POSTHOG_KEY="your_posthog_project_key"
POSTHOG_HOST="https://us.i.posthog.com"

# Server Port (for custom server deployments)
PORT=3000

# Google AdSense (Optional - About Section Only)
ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
ADSENSE_ABOUT_SLOT="XXXXXXXXXX"

# YouTube Data API v3 (Optional for Server-side Sync — Fallback RSS parser active if omitted)
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"
