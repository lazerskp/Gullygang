{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "checkJs": false,
    "allowJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": [
    "src/**/*",
    "api/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scratch",
    "services"
  ]
}
